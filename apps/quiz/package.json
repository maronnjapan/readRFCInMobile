{
  "name": "@rfc-reader/quiz",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare WorkersとHonoで動く仕様理解クイズ",
  "scripts": {
    "pretest": "node scripts/build-question-catalog.mjs",
    "test": "node --test test/*.test.mjs",
    "build": "node scripts/build.mjs",
    "dev": "npm run build && wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "check:workers": "npm run build && wrangler deploy --dry-run",
    "deploy:workers": "node scripts/deploy.mjs",
    "author": "node tools/authoring/quiz.mjs",
    "destroy:workers": "node scripts/destroy.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "codemirror": "^6.0.2",
    "hono": "^4.13.18",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20261110.1-beta",
    "wrangler": "^4.160.1",
    "yaml": "^2.9.1"
  }
}
