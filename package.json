{
  "name": "read-rfc-in-mobile",
  "version": "1.0.0",
  "description": "RFC/PDF リーダーと Cloudflare Workers で動く理解度確認問題",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "npm run test:reader && npm run test --workspace @rfc-reader/quiz",
    "serve": "python3 -m http.server 8080",
    "fetch": "node scripts/fetch-rfc.mjs",
    "build": "node scripts/build-assets.mjs",
    "dev": "npm run dev --workspace @rfc-reader/quiz",
    "db:migrate:local": "npm run db:migrate:local --workspace @rfc-reader/quiz",
    "db:migrate:remote": "npm run db:migrate:remote --workspace @rfc-reader/quiz",
    "check:workers": "npm run check:workers --workspace @rfc-reader/quiz",
    "deploy:workers": "npm run deploy:workers --workspace @rfc-reader/quiz --",
    "test:reader": "node --test test/*.test.mjs",
    "destroy:workers": "npm run destroy:workers --workspace @rfc-reader/quiz --"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "workspaces": [
    "apps/quiz"
  ]
}
