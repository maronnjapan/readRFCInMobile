ms":[{"s":"NIST Special Publication 800-999","x":72.1,"y":96.3,"w":373.2,"h":26,"f":0,"e":1},{"s":"Example Digital Guidelines","x":72.1,"y":133,"w":223,"h":20,"f":1,"e":2},{"s":"Authentication and Lifecycle Management","x":72.1,"y":163.8,"w":273.8,"h":16,"f":1,"e":3},{"s":"Jane Q. Example","x":72.1,"y":189.1,"w":81.6,"h":12,"f":1,"e":4},{"s":"John R. Sample","x":72.1,"y":205,"w":75.6,"h":12,"f":1,"e":4},{"s":"This publication is available free of charge from:","x":72.1,"y":227.9,"w":215.1,"h":11,"f":1,"e":5},{"s":"https://doi.org/10.6028/NIST.SP.800-999","x":72.1,"y":242.4,"w":182.6,"h":11,"f":1,"e":5}]},{"w":612,"h":792,"items":[{"s":"NIST SP 800-999 ","x":72.1,"y":44.4,"w":64.5,"h":9,"f":1,"a":1},{"s":"EXAMPLE DIGITAL GUIDELINES","x":237.6,"y":44.4,"w":136.9,"h":9,"f":1,"a":1},{"s":"Abstract","x":72.1,"y":85.1,"w":52.1,"h":14,"f":0,"e":7},{"s":"These guidelines provide technical requirements for federal agencies implementing digital identity","x":72.1,"y":108.8,"w":433.3,"h":11,"f":1,"e":8},{"s":"services. They are not intended to constrain the development or use of standards outside of this purpose.","x":72.1,"y":123.3,"w":457.9,"h":11,"f":1,"e":8},{"s":"This document defines technical requirements for each of the three authenticator assurance levels.","x":72.1,"y":137.8,"w":430.5,"h":11,"f":1,"e":8},{"s":"Keywords","x":72.1,"y":163.1,"w":60.6,"h":14,"f":0,"e":9},{"s":"authentication; authenticator; credential service provider; digital authentication; passwords.","x":72.1,"y":186.8,"w":401.5,"h":11,"f":1,"e":10},{"s":"Table of Contents","x":72.1,"y":212.1,"w":106.5,"h":14,"f":0,"e":11},{"s":"1 Purpose ........................................................................................ 3","x":72.1,"y":235.8,"w":296.7,"h":11,"f":1,"e":12},{"s":"2 Introduction ................................................................................ 3","x":72.1,"y":258.3,"w":293.6,"h":11,"f":1,"e":13},{"s":"2.1 Notations ............................................................................. 4","x":80.4,"y":280.8,"w":282,"h":11,"f":1,"e":14},{"s":"3 Authenticator Assurance Levels ....................................................... 4","x":72.1,"y":303.3,"w":311.5,"h":11,"f":1,"e":15},{"s":"References ....................................................................................... 6","x":72.1,"y":325.8,"w":299,"h":11,"f":1,"e":16},{"s":"This publication is available free of charge from: https://doi.org/10.6028/NIST.SP.800-999 ","x":72.1,"y":753.6,"w":400.5,"h":11,"f":1,"a":1},{"s":"2","x":534.6,"y":753.6,"w":5.5,"h":11,"f":1,"a":1}]},{"w":612,"h":792,"items":[{"s":"NIST SP 800-999 ","x":72.1,"y":44.4,"w":64.5,"h":9,"f":1,"a":1},{"s":"EXAMPLE DIGITAL GUIDELINES","x":237.6,"y":44.4,"w":136.9,"h":9,"f":1,"a":1},{"s":"1 Purpose","x":72.1,"y":85.4,"w":57.8,"h":14,"f":2,"e":18},{"s":"This section is informative. This document and its companion documents provide technical guidelines to","x":72.1,"y":101.9,"w":460.3,"h":11,"f":1,"e":19},{"s":"agencies for the implementation of digital authentication. The guidelines are intended to be used by","x":72.1,"y":116.4,"w":437.3,"h":11,"f":1,"e":19},{"s":"agencies that provide online services to members of the public as well as to their own employees and","x":72.1,"y":130.9,"w":444,"h":11,"f":1,"e":19},{"s":"contractors.","x":72.1,"y":145.4,"w":51.6,"h":11,"f":1,"e":19},{"s":"The terms “SHALL” and “SHALL NOT” indicate requirements to be followed strictly in order to","x":72.1,"y":167.9,"w":429.7,"h":11,"f":1,"e":20},{"s":"conform to the publication and from which no deviation is permitted. The terms “SHOULD” and","x":72.1,"y":182.4,"w":427,"h":11,"f":1,"e":20},{"s":"“SHOULD NOT” indicate that among several possibilities one is recommended as particularly suitable","x":72.1,"y":196.9,"w":454.1,"h":11,"f":1,"e":20},{"s":"[SP800-63].","x":72.1,"y":211.4,"w":53.5,"h":11,"f":1,"e":20},{"s":"2 Introduction","x":72.1,"y":253,"w":82.9,"h":14,"f":2,"e":21},{"s":"Authentication is the process of determining the validity of one or more authenticators used to claim a","x":72.1,"y":269.5,"w":448.6,"h":11,"f":1,"e":22},{"s":"digital identity. Successful authentication provides reasonable risk-based assurances that the subscriber","x":72.1,"y":284.1,"w":453.2,"h":11,"f":1,"e":22},{"s":"accessing the service today is the same as the one who accessed the service previously, as described in","x":72.1,"y":298.6,"w":450.4,"h":11,"f":1,"e":22},{"s":"Section 3.","x":72.1,"y":313.1,"w":44,"h":11,"f":1,"e":22},{"s":"The following properties are required of every authenticator:","x":72.1,"y":335.6,"w":267,"h":11,"f":1,"e":23},{"s":" ","x":72.1,"y":358.1,"w":4.5,"h":11,"f":3,"e":26},{"s":"The authenticator SHALL be resistant to replay attacks, as defined in Table 1.","x":90.1,"y":358.1,"w":343,"h":11,"f":1,"e":28},{"s":" ","x":72.1,"y":372.6,"w":4.5,"h":11,"f":3,"e":30},{"s":"The verifier SHALL use approved encryption and an authenticated protected channel when","x":90.1,"y":372.6,"w":401.3,"h":11,"f":1,"e":32},{"s":"requesting memorized secrets in order to provide resistance to eavesdropping and machine-in-the-","x":90.1,"y":387.1,"w":431.2,"h":11,"f":1,"e":32},{"s":"middle attacks.","x":90.1,"y":401.6,"w":66.5,"h":11,"f":1,"e":32},{"s":" ","x":72.1,"y":416.1,"w":4.5,"h":11,"f":3,"e":34},{"s":"Verifiers SHOULD permit claimants to use “paste” functionality when entering a memorized secret.","x":90.1,"y":416.1,"w":441.5,"h":11,"f":1,"e":36},{"s":"2.1 Notations","x":72.1,"y":442.7,"w":72.7,"h":13,"f":2,"e":37},{"s":"This guideline uses the following typographical conventions in text:","x":72.1,"y":458.8,"w":299.1,"h":11,"f":1,"e":38},{"s":"1. ","x":72.1,"y":481.3,"w":8.3,"h":11,"f":1,"e":41},{"s":"Specific terms in CAPITALS represent normative requirements.","x":90.1,"y":481.3,"w":282.9,"h":11,"f":1,"e":43},{"s":"2. ","x":72.1,"y":495.8,"w":8.3,"h":11,"f":1,"e":45},{"s":"Terms in italics represent defined terms in the glossary.","x":90.1,"y":495.8,"w":243.8,"h":11,"f":1,"e":47},{"s":"3 Authenticator Assurance Levels","x":72.1,"y":537.4,"w":192.7,"h":14,"f":2,"e":48},{"s":"In order to satisfy the requirements of a given AAL, a claimant SHALL be authenticated with at least a","x":72.1,"y":553.9,"w":453.2,"h":11,"f":1,"e":49},{"s":"given level of strength to be recognized as a subscriber. The result of an authentication process is an","x":72.1,"y":568.4,"w":440.1,"h":11,"f":1,"e":49},{"s":"identifier that SHALL be used each time that subscriber authenticates to that relying party.","x":72.1,"y":582.9,"w":398.5,"h":11,"f":1,"e":49},{"s":"Table 1. Summary of Requirements by AAL","x":72.1,"y":604.5,"w":189.1,"h":10,"f":0,"e":50},{"s":"Requirement ","x":72.1,"y":627.2,"w":56.7,"h":11,"f":1,"e":54},{"s":"AAL1 ","x":189.1,"y":627.2,"w":28.1,"h":11,"f":1,"e":56},{"s":"AAL2 ","x":306.1,"y":627.2,"w":28.1,"h":11,"f":1,"e":58},{"s":"AAL3","x":423.1,"y":627.2,"w":28.1,"h":11,"f":1,"e":60},{"s":"Permitted authenticator","x":72.1,"y":648.3,"w":102.8,"h":11,"f":1,"e":63},{"s":"types","x":72.1,"y":661,"w":23.2,"h":11,"f":1,"e":63},{"s":"Memorized Secret;","x":189.1,"y":648.3,"w":83.9,"h":11,"f":1,"e":65},{"s":"Look-Up Secret","x":189.1,"y":661,"w":70.5,"h":11,"f":1,"e":65},{"s":"MF OTP Device; MF","x":306.1,"y":648.3,"w":95,"h":11,"f":1,"e":67},{"s":"Crypto Software","x":306.1,"y":661,"w":73,"h":11,"f":1,"e":67},{"s":"MF Crypto Device","x":423.1,"y":648.3,"w":83,"h":11,"f":1,"e":69},{"s":"Reauthentication ","x":72.1,"y":682.1,"w":74.4,"h":11,"f":1,"e":72},{"s":"30 days ","x":189.1,"y":682.1,"w":33.9,"h":11,"f":1,"e":74},{"s":"12 hours, or 30 minutes","x":306.1,"y":682.1,"w":104.1,"h":11,"f":1,"e":76},{"s":"of inactivity","x":306.1,"y":694.8,"w":53.4,"h":11,"f":1,"e":76},{"s":"12 hours, or 15 minutes","x":423.1,"y":682.1,"w":104.1,"h":11,"f":1,"e":78},{"s":"of inactivity","x":423.1,"y":694.8,"w":53.4,"h":11,"f":1,"e":78},{"s":"Replay resistance ","x":72.1,"y":715.9,"w":77.2,"h":11,"f":1,"e":81},{"s":"Not required ","x":189.1,"y":715.9,"w":55.9,"h":11,"f":1,"e":83},{"s":"Required ","x":306.1,"y":715.9,"w":40.3,"h":11,"f":1,"e":85},{"s":"Required","x":423.1,"y":715.9,"w":40.3,"h":11,"f":1,"e":87},{"s":"This publication is available free of charge from: https://doi.org/10.6028/NIST.SP.800-999 ","x":72.1,"y":753.6,"w":400.5,"h":11,"f":1,"a":1},{"s":"3","x":534.6,"y":753.6,"w":5.5,"h":11,"f":1,"a":1}]},{"w":612,"h":792,"items":[{"s":"NIST SP 800-999 ","x":72.1,"y":44.4,"w":64.5,"h":9,"f":1,"a":1},{"s":"EXAMPLE DIGITAL GUIDELINES","x":237.6,"y":44.4,"w":136.9,"h":9,"f":1,"a":1},{"s":"3.1 Authenticator Assurance Level 1","x":72.1,"y":130.5,"w":193.3,"h":13,"f":2,"e":89},{"s":"AAL1 provides some assurance that the claimant controls an authenticator bound to the subscriber’s","x":72.1,"y":146.6,"w":441,"h":11,"f":1,"e":90},{"s":"account. AAL1 requires either single-factor or multi-factor authentication using a wide range of available","x":72.1,"y":161.1,"w":463.8,"h":11,"f":1,"e":90},{"s":"authentication technologies. Successful authentication requires that the claimant prove possession and","x":72.1,"y":175.6,"w":448.3,"h":11,"f":1,"e":90},{"s":"control of the authenticator through a secure authentication protocol.","x":72.1,"y":190.1,"w":301.8,"h":11,"f":1,"e":90},{"s":"Example request sent by the verifier:","x":72.1,"y":212.6,"w":162,"h":11,"f":1,"e":91},{"s":"POST ","x":72.1,"y":232.4,"w":21.6,"h":9,"f":4,"e":92},{"s":"/authenticate ","x":99.1,"y":232.4,"w":70.2,"h":9,"f":4,"e":92},{"s":"HTTP/1.1","x":174.7,"y":232.4,"w":43.2,"h":9,"f":4,"e":92},{"s":"Host: ","x":72.1,"y":244,"w":27,"h":9,"f":4,"e":92},{"s":"verifier.example.gov","x":104.5,"y":244,"w":108,"h":9,"f":4,"e":92},{"s":"Content-Type: ","x":72.1,"y":255.8,"w":70.2,"h":9,"f":4,"e":92},{"s":"application/json","x":147.7,"y":255.8,"w":86.4,"h":9,"f":4,"e":92},{"s":"{\"otp\": ","x":72.1,"y":279.2,"w":37.8,"h":9,"f":4,"e":92},{"s":"\"123456\"}","x":115.3,"y":279.2,"w":48.6,"h":9,"f":4,"e":92},{"s":"References","x":72.1,"y":320.7,"w":64.4,"h":14,"f":2,"e":93},{