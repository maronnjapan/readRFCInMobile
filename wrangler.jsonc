{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spec-understanding-quiz",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist", "binding": "ASSETS",
    "html_handling": "auto-trailing-slash", "not_found_handling": "none",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{
    "binding": "DB", "database_name": "spec-understanding-quiz",
    "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations"
  }],
  "services": [{ "binding": "AI_EXECUTOR", "service": "ai-execution-api" }],
  "queues": {
    "producers": [{ "binding": "AI_JOBS", "queue": "spec-quiz-ai" }],
    "consumers": [
      { "queue": "spec-quiz-ai", "max_batch_size": 1, "max_retries": 3, "dead_letter_queue": "spec-quiz-ai-dead" },
      { "queue": "spec-quiz-ai-dead", "max_batch_size": 1 }
    ]
  },
  "ratelimits": [{ "name": "AI_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  "vars": {
    "APP_ORIGIN": "https://quiz.example.com",
    "QUESTION_REPOSITORY": "maronnjapan/readRFCInMobile",
    "QUESTION_DEFAULT_BRANCH": "main",
    "CODE_REPOSITORIES": "maronnjapan/readRFCInMobile",
    "ACCESS_ISSUER": "",
    "ACCESS_AUD": "",
    "AUTHOR_SUBJECTS": "",
    "AUTHOR_EMAILS": "",
    "AUTHORING_PROFILE": "quiz-generate-v1",
    "GRADING_PROFILE": "quiz-written-v1"
  },
  "limits": { "cpu_ms": 30000 },
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true }
}
